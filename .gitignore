# Public release allowlist. Research data and historical experiments stay local.
/*
!/.gitignore
!/README.md
!/LICENSE
!/pyproject.toml
!/MANIFEST.in
!/src/
!/tests/
!/examples/
!/docs/
!/.github/
**/__pycache__/
**/*.py[cod]
**/*.nbc
**/*.nbi
**/*.egg-info/
**/.DS_Store
**/.env
**/.env.*
**/*.npz
**/*.npy
**/*.tif
**/*.tiff
**/*.zip
**/*.csv
**/*.xlsx
**/*.log
